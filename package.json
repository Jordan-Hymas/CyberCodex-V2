{
  "name": "cybercodex.io",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive cybersecurity learning platform with tutorials, interactive labs, and educational resources",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:create-admin": "tsx scripts/create-admin-user.ts",
    "db:clear-sessions": "tsx scripts/clear-sessions.ts",
    "test:linux": "node scripts/run-linux-tests.cjs",
    "db:prune-labs": "node scripts/prune-linux-labs.cjs",
    "db:postgres:sync": "node scripts/sync-postgres-schema.cjs",
    "db:postgres:check": "node scripts/sync-postgres-schema.cjs --check && node scripts/check-database-config.cjs",
    "db:postgres:generate": "node scripts/sync-postgres-schema.cjs --check && prisma generate --config prisma.postgresql.config.ts",
    "db:postgres:deploy": "npm run db:postgres:check && prisma migrate deploy --config prisma.postgresql.config.ts",
    "build:postgres": "npm run db:postgres:check && npm run db:postgres:generate && next build",
    "db:sqlite:generate": "prisma generate --config prisma.config.ts",
    "auth:check": "node scripts/check-auth-config.cjs",
    "test:auth": "node scripts/test-auth.cjs",
    "db:postgres:smoke": "node scripts/check-postgres-connection.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@uiw/react-codemirror": "^4.25.3",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.6",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.13",
    "lucide-react": "^0.553.0",
    "memfs": "^4.50.0",
    "next": "^16.0.1",
    "next-auth": "^5.0.0-beta.30",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.4.0",
    "skulpt": "^1.2.0",
    "xterm": "^5.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8",
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/client": "^6.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.9.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.0.1",
    "postcss": "^8.5.6",
    "prisma": "^6.18.0",
    "rehype-highlight": "^7.0.2",
    "rehype-prism-plus": "^2.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3"
  }
}
