// Prisma Schema for CyberCodex.io
// This schema includes Auth.js models, user gamification, and course progress tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH.JS REQUIRED MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials provider (hashed with Argon2id)

  // User profile fields
  username      String?   @unique
  bio           String?
  banner        String?   // Profile banner image URL

  // Gamification fields
  level         Int       @default(1)
  xp            Int       @default(0)         // Current level XP
  totalXp       Int       @default(0)         // Lifetime XP
  streak        Int       @default(0)         // Days in a row
  lastActive    DateTime  @default(now())
  rank          String    @default("Novice")  // "Novice", "Apprentice", "Expert", "Elite"

  // Subscription
  subscriptionTier   String   @default("free") // "free" | "pro"
  subscriptionStatus String?  // "active" | "canceled" | "past_due"
  stripeCustomerId   String?  @unique
  subscriptionEndsAt DateTime?

  // Privacy & Settings
  isPublic      Boolean   @default(true)
  showEmail     Boolean   @default(false)

  // Metadata
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  linuxLabSessions LinuxLabSession[]
  sessions      Session[]
  courseProgress CourseProgress[]
  badges        UserBadge[]
  exercises     UserExercise[]
  loginAttempts LoginAttempt[]
  followers     UserFollow[] @relation("UserFollowers")
  following     UserFollow[] @relation("UserFollowing")

  @@index([email])
  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([token])
}

// ============================================
// COURSE PROGRESS TRACKING
// ============================================

model CourseProgress {
  id                String   @id @default(cuid())
  userId            String
  courseId          String   // Matches course slug in file system

  // Progress metrics
  exercisesCompleted Int     @default(0)
  totalExercises    Int      @default(0)
  projectsCompleted Int      @default(0)
  totalProjects     Int      @default(0)
  xpEarned          Int      @default(0)
  totalXp           Int      @default(0)

  // Completion status
  isCompleted       Boolean  @default(false)
  completedAt       DateTime?

  // Timestamps
  startedAt         DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([isCompleted])
}

model UserExercise {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  exerciseId    String

  // Status
  isCompleted   Boolean  @default(false)
  isLocked      Boolean  @default(false)

  // Code & Submissions
  code          String?
  attempts      Int      @default(0)
  usedSolution  Boolean  @default(false) // Track if user used "Show Solution"

  // Timing
  completedAt   DateTime?
  timeSpent     Int?     // seconds

  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, exerciseId])
  @@index([userId])
  @@index([courseId])
  @@index([isCompleted])
}

// ============================================
// BADGES & ACHIEVEMENTS
// ============================================

model Badge {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String
  icon            String   // Emoji or image URL
  category        String   // "course", "streak", "achievement", "special"

  // Unlock conditions
  courseId        String?
  unlockCondition String   // JSON string with conditions
  xpRequired      Int?

  // Metadata
  createdAt       DateTime @default(now())

  // Relations
  userBadges      UserBadge[]

  @@index([category])
  @@index([courseId])
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String

  // Unlock details
  unlockedAt  DateTime @default(now())

  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

// ============================================
// USER SOCIAL FEATURES
// ============================================

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String   // User who is following
  followingId String   // User being followed

  createdAt   DateTime @default(now())

  // Relations
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============================================
// RATE LIMITING & SECURITY
// ============================================

model LoginAttempt {
  id          String   @id @default(cuid())
  userId      String?
  email       String
  ipAddress   String
  userAgent   String?
  successful  Boolean
  attemptedAt DateTime @default(now())

  // Relations
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([ipAddress])
  @@index([attemptedAt])
  @@index([successful])
}


// One private, persistent environment per authenticated learner and Linux mission.
model LinuxLabSession {
  id            String   @id @default(cuid())
  userId        String
  exerciseId    String
  state         String
  flagHash      String
  version       Int      @default(0)
  attempts      Int      @default(0)
  solvedAt      DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
  // Lets the storage prune find idle environments quickly
  @@index([updatedAt])
}
