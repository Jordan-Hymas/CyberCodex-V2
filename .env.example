# ============================================
# DATABASE
# ============================================
# SQLite for local development (zero setup!)
DATABASE_URL="file:./dev.db"

# For production, switch to PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/cybercodex?schema=public"
# Then change provider in prisma/schema.prisma from "sqlite" to "postgresql"

# ============================================
# AUTH.JS v5
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-here-generate-with-openssl"

# Leave unset in development so sign-in works from any host (localhost or a
# LAN IP like http://192.168.1.20:3000). When set, Auth.js rewrites every
# auth request to this URL, which breaks sign-in from other devices.
# Production: AUTH_URL="https://cybercodex.io"
# AUTH_URL="http://localhost:3000"

# ============================================
# OAUTH PROVIDERS
# ============================================

# Google OAuth
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# GitHub OAuth
# Get from: https://github.com/settings/developers
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ============================================
# EMAIL (Optional - for email verification)
# ============================================
# Get from: https://resend.com
RESEND_API_KEY="re_xxxxx"
EMAIL_FROM="noreply@cybercodex.io"

# ============================================
# RATE LIMITING (Optional but recommended)
# ============================================
# Get from: https://upstash.com (free tier available)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# ============================================
# STRIPE (Optional - for subscriptions)
# ============================================
# Get from: https://stripe.com
STRIPE_SECRET_KEY="sk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"

# ============================================
# NEXT.JS PUBLIC VARIABLES
# ============================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CyberCodex.io"
